# Common Aliases

# Platform-specific aliases
{{- if .is_macos }}
# macOS aliases
alias ls='ls -G'
alias ll='ls -lG'
alias la='ls -laG'
{{- end }}

{{- if .is_linux }}
# Linux aliases
alias ls='ls --color=auto'
alias ll='ls -l --color=auto'
alias la='ls -la --color=auto'
{{- end }}

# Common aliases
alias grep='grep --color=auto'
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'

# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ~='cd ~'

# Shortcuts
alias h='history'
alias c='clear'
alias reload='source ~/.zshrc'

# Git aliases live in ~/.config/git/config ([alias]: st, co, br, ci, cleanup, ...)

# System information
alias df='df -h'
alias du='du -h'
command -v free >/dev/null && alias free='free -h'

# Safe operations
{{- if .is_macos }}
# rm -> macOS Trash (recoverable). rm flags (-r -f -i -v) are ignored; with -f,
# missing files are skipped silently. Real rm: `command rm` or `\rm`.
rm() {
    local -a files; local a force=0 end=0
    for a in "$@"; do
        if (( ! end )) && [[ $a == -- ]]; then end=1
        elif (( ! end )) && [[ $a == -?* ]]; then [[ $a == *f* ]] && force=1
        elif (( force )) && [[ ! -e $a && ! -L $a ]]; then :
        elif [[ $a == -* ]]; then files+=("./$a")   # trash has no `--`
        else files+=("$a"); fi
    done
    (( ${#files} )) || { (( force )) && return 0; print -u2 "usage: rm file..."; return 1; }
    /usr/bin/trash "${files[@]}"
}
{{- else }}
alias rm='rm -i'
{{- end }}
alias cp='cp -i'
alias mv='mv -i'

# Modern replacements (if available)
command -v bat >/dev/null && alias cat='bat'
if command -v eza >/dev/null; then
    # ls -> eza (coloured columns), translating ls sort flags that eza spells
    # differently: -t (mtime, newest first; -tc ctime, -tu atime), -S (size, largest
    # first), -r (reverse).
    # eza's own -t/-S take other meanings, so they're rewritten here.
    # Real ls: `command ls`.
    unalias ls 2>/dev/null
    function ls {   # `function` form: immune to the ls alias defined above
        local -a args; local a f sort= rev=0 end=0
        for a in "$@"; do
            if (( ! end )) && [[ $a == -- ]]; then end=1; args+=($a)
            elif (( ! end )) && [[ $a == -[^-]* ]]; then
                f=${a#-}
                [[ $f == *t* ]] && sort=modified
                [[ $f == *t* && $f == *c* ]] && sort=changed    # ls -tc: ctime
                [[ $f == *t* && $f == *u* ]] && sort=accessed   # ls -tu: atime
                [[ $f == *S* ]] && sort=size
                [[ $f == *r* ]] && rev=1
                # Drop flags eza reads differently: -h (header; sizes are already
                # human-readable), -G (grid; macOS ls colour flag), -c/-u (handled above).
                f=${f//[tSrhGcu]}
                [[ -n $f ]] && args+=(-$f)
            else args+=($a); fi
        done
        # ls -t/-S show newest/largest first; eza sorts ascending, so invert.
        if [[ -n $sort ]]; then
            args=(--sort=$sort $args)
            (( rev )) || args=(-r $args)
        elif (( rev )); then
            args=(-r $args)
        fi
        eza "${args[@]}"
    }
    alias ll='eza -l --git'
    alias la='eza -la --git'
    alias lt='eza --tree --level=2'
fi

# Kubernetes aliases
if command -v kubecolor >/dev/null; then
    # kubecolor: colorized kubectl output (including -o yaml/json)
    alias kubectl='kubecolor'
    alias k='kubecolor'
    compdef kubecolor=kubectl
elif command -v kubectl >/dev/null; then
    alias k='kubectl'
fi

# Editor shortcuts
if command -v nvim >/dev/null; then
    alias v='nvim'
    alias vi='nvim'
    alias vim='nvim'
    alias nv='nvim'
    alias nvd='nvim -d'  # Diff mode
    alias vimrc='nvim ~/.config/nvim/init.lua'
    alias nvimrc='nvim ~/.config/nvim/init.lua'
else
    alias v='vim'
    alias vi='vim'
fi