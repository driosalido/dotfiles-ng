# Common Aliases

# Platform-specific aliases
{{- if .is_macos }}
# macOS aliases
alias ls='ls -G'
alias ll='ls -lG'
alias la='ls -laG'
{{- end }}

{{- if .is_linux }}
# Linux aliases
alias ls='ls --color=auto'
alias ll='ls -l --color=auto'
alias la='ls -la --color=auto'
{{- end }}

# Common aliases
alias grep='grep --color=auto'
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'

# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ~='cd ~'

# Shortcuts
alias h='history'
alias c='clear'
alias reload='source ~/.zshrc'

# Git aliases: provided by the Oh My Zsh git plugin (gst, gc, gp, gl, gco, ...)

# System information
alias df='df -h'
alias du='du -h'
command -v free >/dev/null && alias free='free -h'

# Safe operations
{{- if .is_macos }}
# rm -> macOS Trash (recoverable). rm flags (-r -f -i -v) are ignored; with -f,
# missing files are skipped silently. Real rm: `command rm` or `\rm`.
rm() {
    local -a files; local a force=0 end=0
    for a in "$@"; do
        if (( ! end )) && [[ $a == -- ]]; then end=1
        elif (( ! end )) && [[ $a == -?* ]]; then [[ $a == *f* ]] && force=1
        elif (( force )) && [[ ! -e $a && ! -L $a ]]; then :
        elif [[ $a == -* ]]; then files+=("./$a")   # trash has no `--`
        else files+=("$a"); fi
    done
    (( ${#files} )) || { (( force )) && return 0; print -u2 "usage: rm file..."; return 1; }
    /usr/bin/trash "${files[@]}"
}
{{- else }}
alias rm='rm -i'
{{- end }}
alias cp='cp -i'
alias mv='mv -i'

# Modern replacements (if available)
command -v bat >/dev/null && alias cat='bat'
if command -v eza >/dev/null; then
    alias ls='eza'
    alias ll='eza -l --git'
    alias la='eza -la --git'
    alias lt='eza --tree --level=2'
fi

# Kubernetes aliases
if command -v kubecolor >/dev/null; then
    # kubecolor: colorized kubectl output (including -o yaml/json)
    alias kubectl='kubecolor'
    alias k='kubecolor'
    compdef kubecolor=kubectl
elif command -v kubectl >/dev/null; then
    alias k='kubectl'
fi

# Editor shortcuts
if command -v nvim >/dev/null; then
    alias v='nvim'
    alias vi='nvim'
    alias vim='nvim'
    alias nv='nvim'
    alias nvd='nvim -d'  # Diff mode
    alias vimrc='nvim ~/.config/nvim/init.lua'
    alias nvimrc='nvim ~/.config/nvim/init.lua'
else
    alias v='vim'
    alias vi='vim'
fi