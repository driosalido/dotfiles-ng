# Third-party code pulled by chezmoi (cloned if missing, `git pull` at most once a week).
# On macOS the zsh plugins and fonts come from the Brewfile instead.
# Force an update now: chezmoi apply --refresh-externals   (or: chezmoi apply -R)

{{- if .is_linux }}
# fzf-tab (Homebrew provides it on macOS; no Fedora package).
[".local/share/zsh/plugins/fzf-tab"]
    type = "git-repo"
    url = "https://github.com/Aloxaf/fzf-tab.git"
    refreshPeriod = "168h"
    clone.args = ["--depth", "1"]
    pull.args = ["--ff-only"]
{{- end }}

# MesloLGS NF (Nerd Font icons for the prompt). macOS gets Nerd Fonts from the Brewfile casks.
{{- if .is_linux }}
{{- $fontDir := ".local/share/fonts" }}
{{- range list "Regular" "Bold" "Italic" "Bold Italic" }}

["{{ $fontDir }}/MesloLGS NF {{ . }}.ttf"]
    type = "file"
    url = "https://github.com/romkatv/powerlevel10k-media/raw/master/MesloLGS%20NF%20{{ . | replace " " "%20" }}.ttf"
{{- end }}
{{- end }}
