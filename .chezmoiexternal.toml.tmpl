# Third-party code pulled by chezmoi (cloned if missing, `git pull` at most once a week).
# On macOS the zsh plugins and fonts come from the Brewfile instead.
# Force an update now: chezmoi apply --refresh-externals   (or: chezmoi apply -R)

# Catppuccin themes (Mocha, mauve accent) for tools without a built-in one
[".config/atuin/themes/catppuccin-mocha-mauve.toml"]
    type = "file"
    url = "https://raw.githubusercontent.com/catppuccin/atuin/main/themes/mocha/catppuccin-mocha-mauve.toml"
    refreshPeriod = "720h"

[".config/yazi/flavors/catppuccin-mocha.yazi/flavor.toml"]
    type = "file"
    url = "https://raw.githubusercontent.com/yazi-rs/flavors/main/catppuccin-mocha.yazi/flavor.toml"
    refreshPeriod = "720h"

[".config/yazi/flavors/catppuccin-mocha.yazi/tmtheme.xml"]
    type = "file"
    url = "https://raw.githubusercontent.com/yazi-rs/flavors/main/catppuccin-mocha.yazi/tmtheme.xml"
    refreshPeriod = "720h"

[".config/eza/theme.yml"]
    type = "file"
    url = "https://raw.githubusercontent.com/catppuccin/eza/main/themes/mocha/catppuccin-mocha-mauve.yml"
    refreshPeriod = "720h"

[".config/k9s/skins/catppuccin-mocha-transparent.yaml"]
    type = "file"
    url = "https://raw.githubusercontent.com/catppuccin/k9s/main/dist/catppuccin-mocha-transparent.yaml"
    refreshPeriod = "720h"

[".config/lazygit/catppuccin-mocha.yml"]
    type = "file"
    url = "https://raw.githubusercontent.com/catppuccin/lazygit/main/themes-mergable/mocha/mauve.yml"
    refreshPeriod = "720h"

{{- if .is_linux }}
# fzf-tab (Homebrew provides it on macOS; no Fedora package).
[".local/share/zsh/plugins/fzf-tab"]
    type = "git-repo"
    url = "https://github.com/Aloxaf/fzf-tab.git"
    refreshPeriod = "168h"
    clone.args = ["--depth", "1"]
    pull.args = ["--ff-only"]
{{- end }}

# MesloLGS NF (Nerd Font icons for the prompt). macOS gets Nerd Fonts from the Brewfile casks.
{{- if .is_linux }}
{{- $fontDir := ".local/share/fonts" }}
{{- range list "Regular" "Bold" "Italic" "Bold Italic" }}

["{{ $fontDir }}/MesloLGS NF {{ . }}.ttf"]
    type = "file"
    url = "https://github.com/romkatv/powerlevel10k-media/raw/master/MesloLGS%20NF%20{{ . | replace " " "%20" }}.ttf"
{{- end }}
{{- end }}
