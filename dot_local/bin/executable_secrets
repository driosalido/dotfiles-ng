#!/usr/bin/env bash
# secrets — env secrets with Bitwarden as source of truth and the macOS Keychain as local cache.
#
# Each project has a Bitwarden Secure Note named "envrc:<name>" whose notes body is shell
# (`export VAR="value"` lines). `secrets sync` copies notes into the Keychain; direnv loads
# them with `use keychain_env <name>` (see ~/.config/direnv/direnvrc) without unlocking Bitwarden.
#
#   secrets sync [name...]   Bitwarden -> Keychain (all envrc:* notes if no name)
#   secrets push name file   create/update the Bitwarden note from file, then sync it
#   secrets edit name        edit the note in $EDITOR (temp file in a private dir), push
#   secrets list             list envrc:* notes in Bitwarden
#   secrets get name         print the cached secrets from the Keychain
#   secrets forget name      remove the Keychain cache for name
set -euo pipefail

PREFIX="envrc:"
CHUNK=2000   # `security -i` truncates long input lines; store values in chunks

die() { echo "secrets: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "$1 not found"; }

bw_session() {
    need bw; need jq
    local st; st=$(bw status 2>/dev/null | jq -r .status)
    case "$st" in
        unauthenticated) die "not logged in to Bitwarden: run 'bw login'";;
        unlocked) return 0;;
    esac
    if [[ -z "${BW_SESSION:-}" ]] || [[ "$st" == locked && -n "${BW_SESSION:-}" && "$(bw status --session "$BW_SESSION" | jq -r .status)" != unlocked ]]; then
        echo "Unlocking Bitwarden..." >&2
        BW_SESSION=$(bw unlock --raw) || die "unlock failed"
        export BW_SESSION
    fi
    bw sync --quiet >/dev/null 2>&1 || true
}

kc_del() {  # delete all chunks of a service
    local svc=$1 i=0
    while security delete-generic-password -a "$USER" -s "$svc#$i" >/dev/null 2>&1; do i=$((i+1)); done
}

kc_put() {  # kc_put service  (value on stdin)
    local svc=$1 b64 i=0 n
    b64=$(base64 | tr -d '\n')
    kc_del "$svc"
    n=$(( (${#b64} + CHUNK - 1) / CHUNK ))
    {
        for (( i=0; i<n; i++ )); do
            printf 'add-generic-password -U -a %s -s %s -w %s\n' "$USER" "$svc#$i" "${b64:i*CHUNK:CHUNK}"
        done
    } | security -i >/dev/null
}

kc_get() {  # kc_get service -> value on stdout
    local svc=$1 i=0 part out=""
    while part=$(security find-generic-password -a "$USER" -s "$svc#$i" -w 2>/dev/null); do
        out+=$part; i=$((i+1))
    done
    (( i > 0 )) || return 1
    printf '%s' "$out" | base64 -d
}

note_id() { bw list items --search "$PREFIX$1" | jq -r --arg n "$PREFIX$1" '[.[] | select(.name==$n)][0].id // empty'; }

cmd_sync() {
    bw_session
    local names=("$@")
    if (( ${#names[@]} == 0 )); then
        mapfile -t names < <(bw list items --search "$PREFIX" | jq -r --arg p "$PREFIX" '.[] | select(.type==2 and (.name|startswith($p))) | .name | ltrimstr($p)')
    fi
    (( ${#names[@]} )) || die "no $PREFIX* notes in Bitwarden"
    local n id
    for n in "${names[@]}"; do
        id=$(note_id "$n"); [[ -n "$id" ]] || die "no Bitwarden note $PREFIX$n"
        bw get item "$id" | jq -j '.notes // ""' | kc_put "$PREFIX$n"
        echo "synced $PREFIX$n"
    done
}

cmd_push() {
    local n=${1:?name} src=${2:?file} f
    [[ -r "$src" ]] || die "cannot read $src"
    # Copy once to a private temp file: src may be a pipe/process substitution read twice below
    local tmpd; tmpd=$(mktemp -d); chmod 700 "$tmpd"; f="$tmpd/in"
    trap 'rm -rf "$tmpd"' RETURN
    cat "$src" > "$f"
    [[ -s "$f" ]] || die "refusing to push empty input"
    bash -n "$f" || die "syntax error in $src; not pushed"
    bw_session
    local id; id=$(note_id "$n")
    if [[ -n "$id" ]]; then
        bw get item "$id" | jq --rawfile c "$f" '.notes=$c' | bw encode | bw edit item "$id" >/dev/null
        echo "updated Bitwarden note $PREFIX$n"
    else
        bw get template item | jq --arg n "$PREFIX$n" --rawfile c "$f" \
            '.type=2 | .name=$n | .notes=$c | .secureNote={type:0} | .login=null | .fields=[]' \
            | bw encode | bw create item >/dev/null
        echo "created Bitwarden note $PREFIX$n"
    fi
    kc_put "$PREFIX$n" < "$f"
    echo "synced $PREFIX$n"
}

cmd_edit() {
    local n=${1:?name} d f
    bw_session
    d=$(mktemp -d); chmod 700 "$d"; f="$d/$n.env"
    trap 'rm -rf "$d"' EXIT
    local id; id=$(note_id "$n")
    [[ -n "$id" ]] && bw get item "$id" | jq -j '.notes // ""' > "$f" || : > "$f"
    local before; before=$(shasum "$f")
    "${EDITOR:-vi}" "$f"
    [[ "$(shasum "$f")" == "$before" ]] && { echo "no changes"; return; }
    bash -n "$f" || die "syntax error; not saved"
    cmd_push "$n" "$f"
}

cmd_list() { bw_session; bw list items --search "$PREFIX" | jq -r --arg p "$PREFIX" '.[] | select(.type==2 and (.name|startswith($p))) | .name'; }
cmd_get() { kc_get "$PREFIX${1:?name}" || die "no Keychain cache for $PREFIX$1 (run: secrets sync $1)"; }
cmd_forget() { kc_del "$PREFIX${1:?name}"; echo "removed Keychain cache $PREFIX$1"; }

case "${1:-}" in
    sync)   shift; cmd_sync "$@";;
    push)   shift; cmd_push "$@";;
    edit)   shift; cmd_edit "$@";;
    list)   shift; cmd_list;;
    get)    shift; cmd_get "$@";;
    forget) shift; cmd_forget "$@";;
    *) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 1;;
esac
