#!/usr/bin/env bash
# secrets — env secrets with Bitwarden as source of truth and the macOS Keychain as local cache.
#
# Each project has a Bitwarden item named "envrc:<name>" (legacy "ws/<name>" also works) whose
# notes are env lines: `export VAR="value"` (shell) or `VAR=value` (dotenv-style). Item fields
# named `file:<attachment>` with a path as value download that attachment there on sync.
# direnv loads the cache with `use keychain_env <name>` (~/.config/direnv/direnvrc).
#
#   secrets sync [name...]   Bitwarden -> Keychain (+ attachments); all items if no name
#   secrets push name file   create/update the item notes from file, then sync it
#   secrets edit name        edit the notes in $EDITOR (temp file in a private dir), push
#   secrets list             list envrc:* (and legacy ws/*) items in Bitwarden
#   secrets env name         print `export` lines from the Keychain cache (for .envrc / MCP)
#   secrets get name         print the cached notes verbatim
#   secrets forget name      remove the Keychain cache for name
#   secrets adopt name       rename the legacy item ws/<name> to envrc:<name>
#
# Docs: ~/.local/share/chezmoi/docs/secrets.md
set -euo pipefail

PREFIX="envrc:"
LEGACY="ws/"
CHUNK=2000   # `security -i` truncates long input lines; store values in chunks

# Private temp dirs hold decrypted notes. They are tracked globally and removed
# by one EXIT trap: a trap that names a function's local outlives that function
# and, under `set -u`, fails once the local is gone (and leaves the dir behind).
TMPDIRS=()
cleanup_tmp() { local t; for t in ${TMPDIRS[@]+"${TMPDIRS[@]}"}; do rm -rf "$t"; done; }
trap cleanup_tmp EXIT
mktmpd() { TMPD=$(mktemp -d); chmod 700 "$TMPD"; TMPDIRS+=("$TMPD"); }  # result in $TMPD

die() { echo "secrets: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "$1 not found"; }

bw_session() {
    need bw; need jq
    local st; st=$(bw status 2>/dev/null | jq -r .status)
    case "$st" in
        unauthenticated) die "not logged in to Bitwarden: run 'bw login'";;
        unlocked) return 0;;
    esac
    if [[ -z "${BW_SESSION:-}" ]] || [[ "$st" == locked && -n "${BW_SESSION:-}" && "$(bw status --session "$BW_SESSION" | jq -r .status)" != unlocked ]]; then
        echo "Unlocking Bitwarden..." >&2
        BW_SESSION=$(bw unlock --raw) || die "unlock failed"
        export BW_SESSION
    fi
    bw sync --quiet >/dev/null 2>&1 || true
}

kc_del() {  # delete all chunks of a service
    local svc=$1 i=0
    while security delete-generic-password -a "$USER" -s "$svc#$i" >/dev/null 2>&1; do i=$((i+1)); done
}

kc_put() {  # kc_put service  (value on stdin; written via `security -i` stdin, never argv)
    local svc=$1 b64 i=0 n
    b64=$(base64 | tr -d '\n')
    kc_del "$svc"
    n=$(( (${#b64} + CHUNK - 1) / CHUNK ))
    {
        for (( i=0; i<n; i++ )); do
            printf 'add-generic-password -U -a %s -s %s -w %s\n' "$USER" "$svc#$i" "${b64:i*CHUNK:CHUNK}"
        done
    } | security -i >/dev/null
}

kc_get() {  # kc_get service -> value on stdout
    local svc=$1 i=0 part out=""
    while part=$(security find-generic-password -a "$USER" -s "$svc#$i" -w 2>/dev/null); do
        out+=$part; i=$((i+1))
    done
    (( i > 0 )) || return 1
    printf '%s' "$out" | base64 -d
}

item_id() {  # item_id name [exact-item-name]: envrc:<name>, falling back to legacy ws/<name>
    local n=$1 full id
    for full in "$PREFIX$n" "$LEGACY$n"; do
        id=$(bw list items --search "$full" | jq -r --arg n "$full" '[.[] | select(.name==$n)][0].id // empty')
        [[ -n "$id" ]] && { echo "$id"; return 0; }
    done
    return 1
}

list_names() {  # names of envrc:* and legacy ws/* items (envrc wins on duplicates)
    bw list items | jq -r --arg p "$PREFIX" --arg l "$LEGACY" \
        '[.[] | .name | select(startswith($p) or startswith($l)) | ltrimstr($p) | ltrimstr($l)] | unique[]'
}

fetch_attachments() {  # fetch_attachments item-json item-id
    local item=$1 id=$2 name dest att
    while IFS=$'\t' read -r name dest; do
        [[ -n "$name" ]] || continue
        att=$(jq -r --arg f "$name" '[.attachments[]? | select(.fileName==$f)][0].id // empty' <<<"$item")
        [[ -n "$att" ]] || { echo "  missing attachment $name" >&2; continue; }
        dest=${dest/#\~/$HOME}
        mkdir -p -m 700 "$(dirname "$dest")"
        bw get attachment "$att" --itemid "$id" --output "$dest" --quiet
        chmod 600 "$dest"
        echo "  $name -> $dest"
    done < <(jq -r '.fields[]? | select(.name | startswith("file:")) | [(.name | ltrimstr("file:")), .value] | @tsv' <<<"$item")
}

cmd_sync() {
    bw_session
    local names=("$@")
    (( ${#names[@]} )) || mapfile -t names < <(list_names)
    (( ${#names[@]} )) || die "no $PREFIX* items in Bitwarden"
    local n id item
    for n in "${names[@]}"; do
        id=$(item_id "$n") || die "no Bitwarden item $PREFIX$n (or $LEGACY$n)"
        item=$(bw get item "$id")
        jq -j '.notes // ""' <<<"$item" | kc_put "$PREFIX$n"
        echo "synced $n ($(jq -r .name <<<"$item"))"
        fetch_attachments "$item" "$id"
    done
}

cmd_push() {
    local n=${1:?name} src=${2:?file} f
    [[ -r "$src" ]] || die "cannot read $src"
    # Copy once to a private temp file: src may be a pipe/process substitution read twice below
    mktmpd; f="$TMPD/in"
    cat "$src" > "$f"
    [[ -s "$f" ]] || die "refusing to push empty input"
    bash -n "$f" || die "syntax error in $src; not pushed"
    bw_session
    local id
    if id=$(item_id "$n"); then
        bw get item "$id" | jq --rawfile c "$f" '.notes=$c' | bw encode | bw edit item "$id" >/dev/null
        echo "updated Bitwarden item for $n"
    else
        bw get template item | jq --arg n "$PREFIX$n" --rawfile c "$f" \
            '.type=2 | .name=$n | .notes=$c | .secureNote={type:0} | .login=null | .fields=[]' \
            | bw encode | bw create item >/dev/null
        echo "created Bitwarden note $PREFIX$n"
    fi
    kc_put "$PREFIX$n" < "$f"
    echo "synced $n"
}

cmd_edit() {
    local n=${1:?name} f id
    bw_session
    mktmpd; f="$TMPD/$n.env"
    if id=$(item_id "$n"); then bw get item "$id" | jq -j '.notes // ""' > "$f"; else : > "$f"; fi
    local before; before=$(shasum "$f")
    "${EDITOR:-vi}" "$f"
    [[ "$(shasum "$f")" == "$before" ]] && { echo "no changes"; return; }
    bash -n "$f" || die "syntax error; not saved"
    cmd_push "$n" "$f"
}

cmd_adopt() {
    local n=${1:?name} id
    bw_session
    id=$(bw list items --search "$LEGACY$n" | jq -r --arg n "$LEGACY$n" '[.[] | select(.name==$n)][0].id // empty')
    [[ -n "$id" ]] || die "no legacy item $LEGACY$n"
    bw get item "$id" | jq --arg n "$PREFIX$n" '.name=$n' | bw encode | bw edit item "$id" >/dev/null
    echo "renamed $LEGACY$n -> $PREFIX$n (attachments and fields kept)"
}

# Print the cache as `export` lines: shell lines (`export ...`) verbatim, dotenv-style
# `KEY=value` lines quoted safely (surrounding quotes stripped, like the old `ws env`).
cmd_env() {
    local n=${1:?name} content
    content=$(kc_get "$PREFIX$n") || { echo "secrets: no Keychain cache for $PREFIX$n (run: secrets sync $n)" >&2; return 0; }
    python3 -c '
import re, shlex, sys
for line in sys.stdin.read().splitlines():
    s = line.strip()
    if not s or s.startswith("#"):
        continue
    if s.startswith("export "):
        print(s)
        continue
    m = re.match(r"([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)$", s)
    if not m:
        continue
    k, v = m.group(1), m.group(2).strip()
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"\x27":
        v = v[1:-1]
    print(f"export {k}={shlex.quote(v)}")
' <<<"$content"
}

cmd_list() { bw_session; bw list items | jq -r --arg p "$PREFIX" --arg l "$LEGACY" '.[] | .name | select(startswith($p) or startswith($l))'; }
cmd_get() { kc_get "$PREFIX${1:?name}" || die "no Keychain cache for $PREFIX$1 (run: secrets sync $1)"; }
cmd_forget() { kc_del "$PREFIX${1:?name}"; echo "removed Keychain cache $PREFIX$1"; }

case "${1:-}" in
    sync)   shift; cmd_sync "$@";;
    push)   shift; cmd_push "$@";;
    edit)   shift; cmd_edit "$@";;
    adopt)  shift; cmd_adopt "$@";;
    list)   shift; cmd_list;;
    env)    shift; cmd_env "$@";;
    get)    shift; cmd_get "$@";;
    forget) shift; cmd_forget "$@";;
    *) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 1;;
esac
